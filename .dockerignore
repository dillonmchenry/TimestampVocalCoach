# .dockerignore - keep the build context lean
# Docker reads the entire build context before building. Excluding large/irrelevant
# files speeds up `docker build` significantly.

# Version control
.git/
.gitignore
.gitattributes

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Secrets (injected at runtime via --env-file .env)
.env
.env.example

# IDE / OS
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db

# Jupyter artifacts
.ipynb_checkpoints/
notebooks/

# Large data artifacts not needed in the image
data/samples/
data/raw/
data/cache/
data/processed/
data/student_corpus/

# User performance takes (written at runtime, never part of the image)
data/songs/*/performances/

# STARS teacher weights (~700 MB) - not needed for fast/student profile
stars_chinese/
stars_chinese_english_bilingual/
*.ckpt

# STARS third_party runtime outputs (generated at build time inside the image)
third_party/stars/checkpoints/
third_party/stars/infer_out/

# NanoPitch: only the vendored best.pth is needed; exclude other epoch checkpoints
nanopitch/training/runs/*/checkpoints/epoch_*.pth

# pytest cache / tests
.pytest_cache/
tests/

# Scripts only used for local development
scripts/start_tunnel.ps1
